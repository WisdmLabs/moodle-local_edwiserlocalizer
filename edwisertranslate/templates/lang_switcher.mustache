{{!
    @template local_edwisertranslate/ templates/lang_switcher.mustache

    This template renders a language translator dropdown or dropup menu. 
    It includes a language toggle button, a list of available languages, 
    and placeholder containers for Google Translate and a loading spinner.

    Example context (json):
    {
        "is_footer": false,
        "currentlang": "en",
        "appearance": true,
        "languages": [
            {
                "name": "English",
                "code": "en",
                "switchurl": "#",
                "isactive": true
            },
            {
                "name": "Español",
                "code": "es",
                "switchurl": "#",
                "isactive": false
            },
            {
                "name": "Français",
                "code": "fr",
                "switchurl": "#",
                "isactive": false
            }
        ]
    }
}}

<div id="local-translator-wrapper" class="{{#is_footer}}dropup{{/is_footer}}{{^is_footer}}dropdown{{/is_footer}}">
    
    <button class="btn btn-secondary dropdown-toggle" type="button" id="langTranslatorDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        {{#pix}} globe, local_edwisertranslate {{/pix}} {{currentlang}}
    </button>
    
    <div class="dropdown-menu {{#appearance}}theme-dark{{/appearance}}" aria-labelledby="langTranslatorDropdown">
        {{#languages}}
            <a class="dropdown-item lang-switch-link {{#isactive}}active{{/isactive}}" href="{{switchurl}}" data-lang-code="{{code}}">
                {{name}}
            </a>
        {{/languages}}
    </div>

    <div id="google_translate_element2" style="display:none;"></div>
    
    <div class="translate-spinner" style="display:none;">
        <i class="fa fa-spinner fa-spin"></i> Translating...
    </div>
</div>
